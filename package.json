{
  "name": "@scondic/voice-client",
  "version": "0.0.1",
  "description": "SDK client for Voice bots in TypeScript",
  "keywords": [
    "voice"
  ],
  "homepage": "https://github.com/Voice-LLC/voice-typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/Voice-LLC/voice-typescript-sdk/issues"
  },
  "license": "MIT",
  "author": "Scondic <scondic@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Voice-LLC/voice-typescript-sdk"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "generate": "buf generate",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "example": "tsx src/example/index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@microsoft/signalr": "^10.0.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@microsoft/api-extractor": "^7.58.12",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
