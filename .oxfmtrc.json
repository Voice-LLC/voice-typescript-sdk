{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["src/gen", "dist"],
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [
      { "groupName": "relative-up2", "elementNamePattern": ["../../**"] },
      { "groupName": "relative-up1", "elementNamePattern": ["../**"] },
      { "groupName": "relative-here", "elementNamePattern": ["./**"] }
    ],
    "groups": [
      ["type-builtin", "type-external", "value-builtin", "value-external"],
      ["type-internal", "value-internal"],
      "relative-here",
      "relative-up1",
      "relative-up2",
      "unknown"
    ]
  }
}
