{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "sort-imports": ["error", { "ignoreDeclarationSort": true }]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["src/gen", "dist"]
}
